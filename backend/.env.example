# Copy to backend/.env and fill in. The values below are the local development
# ones. Boot lists anything still missing, so running it is a fair way to check.
# Live, these are set in the Railway dashboard rather than from a file.

# The domain people visit, no trailing slash. Live this is the Netlify domain and
# not the Railway URL behind it, since every link the bot posts is built from it
# and the session cookie only goes secure when it starts https. Production will
# not boot unless it does.
BASE_URL=http://localhost:3000

# Port the one service listens on. Railway sets this itself.
PORT=3000

# Connection string, then the database name inside that cluster
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
MONGODB_DB=availability

# Bot token, from the Bot tab of your app in the Discord developer portal
DISCORD_BOT_TOKEN=

# OAuth2 credentials, from the OAuth2 tab of the same app
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Where Discord sends people back after they approve. Blank means BASE_URL plus
# /api/auth/callback, and whatever it ends up being has to be added as a redirect
# in the portal too or login fails on Discord's side.
DISCORD_OAUTH_REDIRECT=

# A test server id while developing: commands registered to one guild appear at
# once, global ones can take an hour. Blank registers globally.
DISCORD_DEV_GUILD_ID=

# Signs the session cookie, so changing it logs everybody out. Any long random
# value, openssl rand -hex 32 or similar.
SESSION_SECRET=

# Only needed if the site is served from somewhere other than BASE_URL. Blank
# means the two share an origin, which they do in every deployment here.
CORS_ORIGIN=

# How many proxies sit in front of the process. Express counts back that many
# hops through X-Forwarded-For to find the real caller, which is what the login
# rate limit counts against. 0 running it directly, 2 live (Netlify, then
# Railway). Leaving it blank reads as 0, so write the number.
TRUST_PROXY=0

# production turns on the boot refusals above. Leave it as is locally.
NODE_ENV=development
